{
  "name": "yapnix-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "admin"
  ],
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.4.3"
    },
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "body-parser": "^2.4.0"
  },
  "scripts": {
    "dev": "concurrently -n backend,admin -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w admin\"",
    "build": "npm run build -w backend && npm run build -w admin",
    "test": "npm run test -w backend && npm run test -w admin",
    "sql:generate": "node supabase/build-sql.mjs",
    "sql:check": "node supabase/build-sql.mjs --check",
    "test:db": "npm run sql:check && node supabase/tests/run.mjs",
    "lint": "npm run lint -w backend && npm run lint -w admin",
    "icons:generate": "node scripts/build-catalog-icons.mjs",
    "icons:check": "node scripts/build-catalog-icons.mjs --check"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.71.1"
  }
}
